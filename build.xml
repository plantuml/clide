<!--
    ========================================================================
                                clide Build File
    ========================================================================
    Fallback build for environments that cannot run the Gradle wrapper
    (typically: no network access to services.gradle.org, e.g. Claude's
    sandbox). Requires only a JDK and Ant — no dependency download: the
    JUnit jars the tests need are committed under lib/ (see
    scripts/fetch_junit.py to fetch or refresh them).

    Usage:
        ant help                     -> full usage: every target, every -D option
        ant -p                       -> the same target list, straight from Ant

        ant                          -> builds clide.jar, a fat jar bundling lib/
                                        and jdt-language-server-latest.zip
                                        (default target: dist)
        ant compile                  -> compiles main classes only, no jar
        ant test-compile             -> compiles the unit tests only
        ant test                     -> runs every unit test under src/test/java
        ant test -Dtest=<FQCN>       -> runs a single test class
        ant run -Dproject=<path>     -> builds and runs clide on <path> (interactive stdin)
        ant clean                    -> removes the build directory and the jar
    ========================================================================
-->
<project name="clide" default="dist" basedir=".">
    <description>
        clide Build File (Ant fallback for Gradle)
    </description>

    <property name="src.dir" value="src/main/java"/>
    <property name="test.src.dir" value="src/test/java"/>
    <property name="lib.dir" value="lib"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="test.classes.dir" value="${build.dir}/test-classes"/>
    <property name="test.reports.dir" value="${build.dir}/test-reports"/>
    <property name="fatjar.dir" value="${build.dir}/fatjar"/>
    <property name="main.class" value="clide.Main"/>
    <property name="jar.file" value="clide.jar"/>
    <property name="jdtls.zip" value="jdt-language-server-latest.zip"/>

    <!--
        Ant re-logs the forked JVM's output through its own PrintStream, built on
        the charset of the JVM *Ant* runs in - so a UTF-8 child still prints "?"
        for every non-ASCII character unless Ant itself was started in UTF-8.
        The ASCII tree keeps the report readable everywhere by default. For the
        nicer box-drawing one (accented @DisplayName included):

            ANT_OPTS="-Dstdout.encoding=UTF-8" ant test -Dtest.theme=unicode
            set ANT_OPTS=-Dstdout.encoding=UTF-8   (Windows)
    -->
    <property name="test.theme" value="ascii"/>

    <!--
        Compiling the tests: the discrete JUnit jars. The console-standalone one
        is deliberately left out here — it repackages all of them, and having
        both on a single classpath means duplicate classes, with whichever
        version comes first winning.
    -->
    <path id="test.compile.classpath">
        <pathelement location="${classes.dir}"/>
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
            <exclude name="junit-platform-console-standalone-*.jar"/>
        </fileset>
    </path>

    <!--
        Running the tests: console-standalone brings the launcher, both engines
        and everything they depend on. The exclusions below are exactly what it
        already contains — any other jar dropped into lib/ (mocking, assertion
        or matcher libraries...) is picked up with no change needed here.
    -->
    <path id="test.runtime.classpath">
        <pathelement location="${classes.dir}"/>
        <pathelement location="${test.classes.dir}"/>
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
            <exclude name="junit-jupiter-*.jar"/>
            <exclude name="junit-platform-commons-*.jar"/>
            <exclude name="junit-platform-engine-*.jar"/>
            <exclude name="junit-platform-launcher-*.jar"/>
            <exclude name="opentest4j-*.jar"/>
            <exclude name="apiguardian-api-*.jar"/>
        </fileset>
    </path>

    <!--
        clide's own code compiles against the JUnit *platform* - and only the
        platform. clide.test.TestRunnerMain drives the Launcher API to run the
        open project's tests (see run_test), so the launcher, the engine SPI and
        their two tiny dependencies are compile-time dependencies of clide
        itself now, not test tooling. Jupiter is deliberately NOT here: clide
        writes no JUnit 5 test of its own in src/main, and leaving it out keeps
        an @Test from being imported into production code by accident.

        The luajava-* group is for clide's Lua entry point (Main.runLuaScript,
        the "lua" flag documented in LUA.md): party.iroiro.luajava (the core
        API), lua51 (the Lua51 class), jnigen-loader/jnigen-commons (native
        library loading at runtime - see scripts/fetch_luajava.py for why
        both are needed) and jspecify (nullability annotations on luajava's
        public API, required by javac even though they have no effect at
        runtime). lua51-platform (the natives-desktop jar, no Java classes of
        its own) is deliberately absent here - only lib/*.jar as a whole,
        via the fat jar's explode-libs target, needs it, not compilation.
    -->
    <path id="main.compile.classpath">
        <fileset dir="${lib.dir}">
            <include name="junit-platform-launcher-*.jar"/>
            <include name="junit-platform-engine-*.jar"/>
            <include name="junit-platform-commons-*.jar"/>
            <include name="opentest4j-*.jar"/>
            <include name="apiguardian-api-*.jar"/>
            <include name="luajava-*.jar"/>
            <include name="lua51-*.jar"/>
            <exclude name="lua51-platform-*.jar"/>
            <include name="jnigen-loader-*.jar"/>
            <include name="jnigen-commons-*.jar"/>
            <include name="jspecify-*.jar"/>
        </fileset>
    </path>

    <target name="compile" description="Compile the main classes into build/classes - no jar">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" release="21" debug="on" encoding="UTF-8" includeantruntime="false">
            <classpath refid="main.compile.classpath"/>
        </javac>
    </target>

    <target name="test-compile" depends="compile" description="Compile the unit tests into build/test-classes">
        <mkdir dir="${test.classes.dir}"/>
        <javac srcdir="${test.src.dir}" destdir="${test.classes.dir}" release="21" debug="on" encoding="UTF-8" includeantruntime="false">
            <classpath refid="test.compile.classpath"/>
        </javac>
    </target>

    <!--
        Test selection. Ant properties are write-once, so exactly one of the two
        targets below gets to set them: -Dtest=<FQCN> narrows the run down to a
        single class (CLAUDE.md, priority 2 — running one targeted test),
        otherwise the whole clide package is scanned.
    -->
    <target name="-select-one-test" if="test">
        <property name="test.selector.flag" value="--select-class"/>
        <property name="test.selector.value" value="${test}"/>
    </target>

    <target name="-select-all-tests" unless="test">
        <property name="test.selector.flag" value="--select-package"/>
        <property name="test.selector.value" value="clide"/>
    </target>

    <target name="test" depends="test-compile,-select-one-test,-select-all-tests"
            description="Run the unit tests - add -Dtest=&lt;FQCN&gt; for a single class">
        <mkdir dir="${test.reports.dir}"/>
        <!--
            fork="true" is required: ConsoleLauncher ends on System.exit(), which
            would take Ant down with it. failonerror="true" turns a failing test
            into a failing build.
        -->
        <java classname="org.junit.platform.console.ConsoleLauncher" fork="true" failonerror="true">
            <classpath refid="test.runtime.classpath"/>
            <!--
                Make the forked JVM emit UTF-8 whatever the platform charset is
                (cp1252 on Windows, US-ASCII under a POSIX locale). This is what
                the XML reports under build/test-reports depend on; the console
                needs one more thing, see test.theme below.
            -->
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Dstderr.encoding=UTF-8"/>
            <jvmarg value="-Dfile.encoding=UTF-8"/>
            <arg value="execute"/>
            <arg value="${test.selector.flag}"/>
            <arg value="${test.selector.value}"/>
            <arg value="--details=tree"/>
            <arg value="--details-theme=${test.theme}"/>
            <arg value="--disable-banner"/>
            <!-- An empty run means a broken selector, not a success. -->
            <arg value="--fail-if-no-tests"/>
            <arg value="--reports-dir=${test.reports.dir}"/>
        </java>
    </target>

    <!--
        ====================================================================
        Fat jar
        ====================================================================
        clide.jar embeds every jar of lib/, so that a single file both runs
        clide (java -jar clide.jar) and runs its tests, with nothing else on
        the classpath:

            java -jar clide.jar <project path>
            java -cp clide.jar org.junit.platform.console.ConsoleLauncher execute (select-package) clide

        Merging jars is not a plain concatenation - three entry kinds need
        care, and getting them wrong fails silently rather than loudly:

        - META-INF/services/*: two jars declaring providers for the SAME
          service must have their declarations *concatenated*. Overwriting
          one with the other loses providers with no warning at all. Handled
          by the merge-services target below.
        - module-info.class: only one module descriptor can sit at a jar's
          root. Ignored on the classpath, but keeping a random dependency's
          one is meaningless, so they all go.
        - META-INF/versions/*: junit-platform-console-standalone and
          junit-platform-commons are multi-release jars. Their versioned
          classes are silently ignored unless the *enclosing* jar is itself
          flagged Multi-Release, hence the manifest attribute below.

        The discrete JUnit jars are excluded: console-standalone repackages
        all of them (plus the launcher and the console runner), so bundling
        both would mean shipping every JUnit class twice.
    -->
    <patternset id="fatjar.redundant.jars">
        <exclude name="junit-jupiter-*.jar"/>
        <exclude name="junit-platform-commons-*.jar"/>
        <exclude name="junit-platform-engine-*.jar"/>
        <exclude name="junit-platform-launcher-*.jar"/>
        <exclude name="opentest4j-*.jar"/>
        <exclude name="apiguardian-api-*.jar"/>
    </patternset>

    <target name="-explode-libs">
        <delete dir="${fatjar.dir}"/>
        <mkdir dir="${fatjar.dir}/classes"/>
        <unzip dest="${fatjar.dir}/classes">
            <fileset dir="${lib.dir}" includes="*.jar">
                <patternset refid="fatjar.redundant.jars"/>
            </fileset>
            <patternset>
                <exclude name="META-INF/MANIFEST.MF"/>
                <exclude name="META-INF/*.SF"/>
                <exclude name="META-INF/*.DSA"/>
                <exclude name="META-INF/*.RSA"/>
                <exclude name="META-INF/*.EC"/>
                <!-- Merged below instead: a plain extract would overwrite. -->
                <exclude name="META-INF/services/**"/>
                <exclude name="**/module-info.class"/>
            </patternset>
        </unzip>
    </target>

    <!--
        Concatenating the service declarations. Ant has no equivalent of a
        shade plugin's ServiceFileTransformer, so each service type declared by
        more than one bundled jar is merged explicitly - today only
        TestExecutionListener, declared by both console-standalone and
        junit-pioneer.

        WHEN ADDING A JAR TO lib/, check what it declares:

            unzip -l lib/<new>.jar | grep META-INF/services

        and if one of those types is already declared by another bundled jar,
        add a <concat> for it here. Skipping that step does not break the
        build - it silently drops providers from clide.jar.
    -->
    <target name="-merge-services" depends="-explode-libs">
        <mkdir dir="${fatjar.dir}/services"/>
        <unzip dest="${fatjar.dir}/services">
            <fileset dir="${lib.dir}" includes="*.jar">
                <patternset refid="fatjar.redundant.jars"/>
            </fileset>
            <patternset includes="META-INF/services/**"/>
        </unzip>

        <concat destfile="${fatjar.dir}/classes/META-INF/services/org.junit.platform.launcher.TestExecutionListener" fixlastline="true">
            <zipfileset src="${lib.dir}/junit-platform-console-standalone-1.10.1.jar"
                        includes="META-INF/services/org.junit.platform.launcher.TestExecutionListener"/>
            <zipfileset src="${lib.dir}/junit-pioneer-2.3.0.jar"
                        includes="META-INF/services/org.junit.platform.launcher.TestExecutionListener"/>
        </concat>

        <!-- The non-colliding ones are copied as-is, without clobbering the merge. -->
        <copy todir="${fatjar.dir}/classes/META-INF/services" overwrite="false">
            <fileset dir="${fatjar.dir}/services/META-INF/services"/>
        </copy>
    </target>

    <!--
        Also bundles ${jdtls.zip} into the jar under a top-level "resource/"
        directory (e.g. resource/jdt-language-server-latest.zip), so jdtls
        ships inside clide.jar rather than needing to sit next to it on disk -
        see JdtlsLauncher.ensureExtracted(), which falls back to that
        classpath resource when the zip isn't found next to jdtlsHome.
    -->
    <target name="-check-jdtls-zip">
        <available file="${jdtls.zip}" property="jdtls.zip.present"/>
        <fail unless="jdtls.zip.present" message="Cannot find ${jdtls.zip} - fetch it first or override the path with -Djdtls.zip=&lt;path&gt;"/>
    </target>

    <!--
        JUnit clide hands out, unexploded, to a target project that has none
        of its own - see clide.jdtls.JunitVendorJars, whose VENDORED_JAR_NAMES
        must be kept in sync by hand with this list. Bundled under the same
        top-level "resource/" directory as ${jdtls.zip} above, in their own
        resource/vendor-junit/ subdirectory so names never collide with it.
    -->
    <patternset id="junit.vendor.jars">
        <include name="junit-platform-console-standalone-*.jar"/>
        <include name="junit-pioneer-*.jar"/>
        <include name="xmlunit-core-*.jar"/>
    </patternset>

    <target name="dist" depends="compile,-merge-services,-check-jdtls-zip"
            description="Build clide.jar, a fat jar bundling every jar of lib/ plus ${jdtls.zip} under resource/ (default)">
        <jar jarfile="${jar.file}" duplicate="fail">
            <fileset dir="${classes.dir}"/>
            <fileset dir="${fatjar.dir}/classes"/>
            <zipfileset file="${jdtls.zip}" fullpath="resource/${jdtls.zip}"/>
            <!-- Whole, unexploded jars for JunitVendorJars to extract into a
                 target project - see the "junit.vendor.jars" patternset above. -->
            <zipfileset dir="${lib.dir}" prefix="resource/vendor-junit">
                <patternset refid="junit.vendor.jars"/>
            </zipfileset>
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <!-- See the comment above: without this the META-INF/versions/
                     classes of the bundled multi-release jars are dead weight. -->
                <attribute name="Multi-Release" value="true"/>
            </manifest>
        </jar>
        <delete dir="${fatjar.dir}"/>
    </target>


    <target name="run" depends="compile" description="Run clide on a project - requires -Dproject=&lt;path&gt;">
        <fail unless="project" message="Usage: ant run -Dproject=&lt;path&gt;"/>
        <java classname="${main.class}" classpath="${classes.dir}" fork="true">
            <!-- fork="true" so stdin is properly connected to the JVM's console -->
            <arg value="${project}"/>
        </java>
    </target>

    <!--
        "ant -p" lists the targets and their description="..." attributes on its
        own; this target exists for what -p cannot show: the -D options, the
        environment variables and the files each target produces.
    -->
    <target name="help" description="Show this help">
        <echo>
clide build - Apache Ant

  Fallback build for environments that cannot run the Gradle wrapper. Needs a
  JDK 21 and Ant, nothing else: the JUnit jars are committed under lib/.

USAGE
  ant [target] [-Dname=value ...]

TARGETS
  dist            Build ${jar.file}, a fat jar bundling every jar of lib/
                  plus ${jdtls.zip} under a top-level resource/ directory.
                  The result runs both clide and its tests on its own, and
                  needs nothing else sitting next to it on disk.
                  This is the default target, so plain "ant" does this.
  compile         Compile the main classes into ${classes.dir}. No jar.
  test-compile    Compile the unit tests into ${test.classes.dir}.
  test            Compile then run the unit tests of ${test.src.dir}.
                  A failing test fails the build. These are clide's own
                  tests; the tests of a project clide has OPEN are run
                  from inside clide, with run_test and run_tests.
  run             Build, then run clide on a project. Needs -Dproject.
  clean           Delete ${build.dir} and ${jar.file}.
  help            Show this message.

OPTIONS
  -Dtest=&lt;FQCN&gt;
        With "test": run that single class instead of every test under the
        clide package. Example: -Dtest=clide.util.UnifiedDiffTest
        Default: every test found in package "clide".

  -Dtest.theme=ascii|unicode
        Characters used to draw the test result tree. "unicode" is nicer but
        only renders correctly on a console Ant itself opened in UTF-8 (see
        ANT_OPTS below).
        Default: ascii.

  -Dproject=&lt;path&gt;
        Required by "run": the project clide should open. Interactive - clide
        reads its commands on standard input.

  Overridable paths, should the layout ever move: -Dsrc.dir, -Dtest.src.dir,
  -Dlib.dir, -Dbuild.dir, -Dclasses.dir, -Dtest.classes.dir,
  -Dtest.reports.dir, -Djar.file, -Dmain.class, -Djdtls.zip.

ENVIRONMENT
  ANT_OPTS=-Dstdout.encoding=UTF-8
        Ant re-encodes the output of the JVM it forks with its own charset, so
        accented test names print as "?" unless Ant itself runs in UTF-8. Set
        this to read them, and -Dtest.theme=unicode along with it.
        Windows:  set ANT_OPTS=-Dstdout.encoding=UTF-8

OUTPUT
  ${jar.file}
        Fat jar. Runnable two ways:
          java -jar ${jar.file} &lt;project path&gt;
          java -cp ${jar.file} org.junit.platform.console.ConsoleLauncher ...
  ${classes.dir}        main classes
  ${test.classes.dir}   test classes
  ${test.reports.dir}   JUnit XML reports, written by every "test" run

EXAMPLES
  ant                                      build the fat jar
  ant clean dist                           rebuild it from scratch
  ant test                                 run every unit test
  ant test -Dtest=clide.util.UnifiedDiffTest    run one test class
  ant run -Dproject=C:\github\plantuml     open clide on PlantUML
  ant -p                                   short target list, from Ant itself</echo>
    </target>

    <target name="clean" description="Remove the build directory and clide.jar">
        <delete dir="${build.dir}"/>
        <delete file="${jar.file}"/>
    </target>

</project>
